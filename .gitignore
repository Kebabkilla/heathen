/subprojects/*/
!/subprojects/packagefiles/
/tags
/TAGS

# Out-of-tree builds and local tooling.
/build/
/builddir/
/build-*/
/.venv/

# Compiled binaries and compiler output.
*.exe
*.dll
*.so
*.dylib
*.pdb
*.obj
*.o
*.a
*.lib
*.exp
*.ilk

# Generated map and diagnostic output; keep .map sources tracked.
*.bsp
*.lit
*.lux
*.prt
*.pts
*.log

# Reproducible blockout assets (generated from tools/generate_blockout.py).
/mygame/pics/colormap.pcx
/mygame/textures/heathen/blockout.wal

# Local Python bytecode from developer tools/tests.
__pycache__/
